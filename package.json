{
  "name": "better-response",
  "version": "1.0.1-dev.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "pnpm --filter @better-response/web build",
    "dev": "agent-playground dev",
    "dev:codex": "agent-playground dev",
    "dev:cursor": "node scripts/dev-cursor.mjs",
    "dev:server": "pnpm --filter @better-response/web dev",
    "storybook": "pnpm --filter @better-response/openai-storybook dev",
    "build:storybook": "pnpm --filter @better-response/openai-storybook build",
    "start": "pnpm --filter @better-response/web start",
    "install:codex": "pnpm --filter @better-response/plugin install:codex",
    "install:cursor": "pnpm --filter @better-response/plugin install:cursor",
    "probe": "pnpm --filter @better-response/web probe",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@enkind/agent-playground": "^0.1.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
